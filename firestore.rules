rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && (request.resource.data.role == "student"
                        || request.resource.data.role == "pending-teacher");
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
    }
    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }
    match /lessons/{lessonId} {
      allow read, write: if request.auth != null;
    }
    match /subjects/{subjectId} {
      allow read, write: if request.auth != null;
    }
    match /schedule/{docId} {
      allow read, write: if request.auth != null;
    }
    // Оцінки учнів за уроки/дз. Doc id = "<lessonId>_<studentId>".
    match /grades/{gradeId} {
      allow read, write: if request.auth != null;
    }
    // Батьківські класи (напр. "8-А")
    match /classes/{classId} {
      allow read, write: if request.auth != null;
    }
    // Групи всередині класу (напр. "1 група") — одиниці розкладу.
    // students.group і schedule/week[groupId] посилаються на id групи.
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }
    match /classDeletionRequests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.teacherUid == request.auth.uid;
      allow update: if false;
    }
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    match /electives/{electiveId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }
    // Вибори старости (по класу)
    match /elections/{electionId} {
      allow read, write: if request.auth != null;
    }
    // Історія старост (хто був з/по яку дату)
    match /starostaHistory/{historyId} {
      allow read, write: if request.auth != null;
    }
    // Повідомлення / сповіщення (recipientUid = auth.uid одержувача)
    match /notifications/{notifId} {
      allow read: if request.auth != null
                  && resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.recipientUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.recipientUid == request.auth.uid;
    }
  }
}
