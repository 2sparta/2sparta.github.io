rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && (request.resource.data.role == "student"
                        || request.resource.data.role == "pending-teacher");
      // Власник оновлює свій профіль. Роль: pending-teacher → teacher|admin.
      // Адмін тієї ж школи може оновлювати інших учителів школи.
      allow update: if request.auth != null
                    && (
                      (request.auth.uid == userId
                        && (
                          resource.data.role == request.resource.data.role
                          || (resource.data.role == "pending-teacher"
                              && (request.resource.data.role == "teacher"
                                  || request.resource.data.role == "admin"))
                          || (resource.data.role == "teacher"
                              && request.resource.data.role == "admin")
                        ))
                      || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
                          && resource.data.schoolId != null
                          && resource.data.schoolId
                              == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId)
                    );
    }
    // Школи
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }
    // Коди-запрошення вчителів (id документа = 16-символьний код)
    match /teacherInvites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;
    }
    match /students/{studentId} {
      allow read, write: if request.auth != null;
    }
    match /lessons/{lessonId} {
      allow read, write: if request.auth != null;
    }
    match /subjects/{subjectId} {
      allow read, write: if request.auth != null;
    }
    match /schedule/{docId} {
      allow read, write: if request.auth != null;
    }
    // Оцінки учнів за уроки/дз. Doc id = "<lessonId>_<studentId>".
    match /grades/{gradeId} {
      allow read, write: if request.auth != null;
    }
    // Батьківські класи (напр. "8-А")
    match /classes/{classId} {
      allow read, write: if request.auth != null;
    }
    // Групи всередині класу (напр. "1 група") — одиниці розкладу.
    // students.group і schedule/week[groupId] посилаються на id групи.
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }
    match /classDeletionRequests/{requestId} {
      allow create: if request.auth != null
                    && request.resource.data.teacherUid == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.teacherUid == request.auth.uid;
      allow update: if false;
    }
    match /mail/{mailId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    match /electives/{electiveId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }
    // Вибори старости (по класу)
    match /elections/{electionId} {
      allow read, write: if request.auth != null;
    }
    // Історія старост (хто був з/по яку дату)
    match /starostaHistory/{historyId} {
      allow read, write: if request.auth != null;
    }
    // Повідомлення / сповіщення (recipientUid = auth.uid одержувача)
    match /notifications/{notifId} {
      allow read: if request.auth != null
                  && resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.recipientUid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.recipientUid == request.auth.uid;
    }
    // Оголошення (шкільні / класові)
    match /announcements/{announcementId} {
      allow read, write: if request.auth != null;
    }
    // Історія змін балів (не оцінок) учнів
    match /pointsHistory/{entryId} {
      allow read, write: if request.auth != null;
    }
    // Чати (групи, DM, авто-групи школи)
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && (
                    !(exists(/databases/$(database)/documents/chats/$(chatId)))
                    || request.auth.uid in resource.data.memberUids
                    || resource.data.isAuto == true
                  );
      allow create: if request.auth != null
                    && (
                      request.auth.uid in request.resource.data.memberUids
                      || request.resource.data.isAuto == true
                    );
      allow update: if request.auth != null
                    && (
                      request.auth.uid in resource.data.memberUids
                      || request.auth.uid in request.resource.data.memberUids
                      || resource.data.isAuto == true
                    );
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid
                    && resource.data.isAuto != true;
    }
    // Повідомлення — лише учасники; update власних (м'яке видалення)
    match /chatMessages/{messageId} {
      allow read: if request.auth != null
                  && request.auth.uid in get(/databases/$(database)/documents/chats/$(resource.data.chatId)).data.memberUids;
      allow create: if request.auth != null
                    && request.resource.data.senderUid == request.auth.uid
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.memberUids;
      allow update: if request.auth != null
                    && resource.data.senderUid == request.auth.uid
                    && request.resource.data.senderUid == resource.data.senderUid
                    && request.resource.data.chatId == resource.data.chatId;
      allow delete: if false;
    }
    match /chatTyping/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }
  }
}
